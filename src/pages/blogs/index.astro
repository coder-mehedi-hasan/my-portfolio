---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/site/PageIntro.astro';
import { formatDate, getPublishedBlogs } from '../../lib/content';

const blogs = await getPublishedBlogs();
---

<BaseLayout
  title="Blogs"
  description="Software engineering writing by Md Mehedi Hasan on web and mobile development, e-commerce platforms, and deployment."
  canonical="/blogs"
>
  <main class="page-shell">
    <PageIntro
      eyebrow="Notes & ideas"
      title="Writing."
      description="Things I’ve learned while building software. Practical notes on development, problem-solving, and shipping to production."
    />
    <div class="editorial-list">
      {blogs.length === 0 && <p class="empty-state">No articles yet. Check back soon.</p>}
      {
        blogs.map((blog) => (
          <a class="editorial-row" href={`/blogs/${blog.id}`}>
            <p class="row-meta">
              {formatDate(blog.data.date, { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}
            </p>
            <div>
              <h2>{blog.data.title}</h2>
              <p class="mt-3">{blog.data.excerpt}</p>
              <p class="row-meta mt-4">{blog.data.author}</p>
            </div>
            <span aria-hidden="true">↗</span>
          </a>
        ))
      }
    </div>
  </main>
</BaseLayout>
