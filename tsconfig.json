{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [".astro/types.d.ts", "src/**/*", "astro.config.mjs"],
  "exclude": [
    "node_modules",
    "dist",
    "app",
    "components",
    "utils",
    "tests",
    "scripts",
    "tools",
    ".next",
    ".next-production"
  ]
}
